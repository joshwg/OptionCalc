# Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================

# Default risk-free rate (as decimal, e.g., 0.05 for 5%)
DEFAULT_RISK_FREE_RATE=0.05

# Default volatility (as decimal, e.g., 0.30 for 30%)
DEFAULT_VOLATILITY=0.30

# ============================================
# Development Settings
# ============================================

# Enable debug logging
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Cache TTLs (seconds)
CACHE_TTL_STOCK=300       # stock price / info
CACHE_TTL_OPTIONS=300     # option chain bids/asks
CACHE_TTL_VOL=1800        # historical volatility
CACHE_TTL_EXPIRIES=1800   # expiration date list
CACHE_TTL_SEARCH=3600     # ticker search results

# ============================================
# Testing
# ============================================

# Use mock data for testing (avoid hitting real APIs)
USE_MOCK_DATA=false

# Test ticker symbol
TEST_TICKER=AAPL
